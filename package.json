{
  "name": "xpressabhi.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "Single source of truth (data/profile.json) → portfolio, CV, PDF, GitHub profile README, career-ops CV",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pdf": "node scripts/build.mjs --pdf",
    "cv:preview": "node scripts/cv-preview.mjs",
    "check": "node scripts/check.mjs",
    "repos:scan": "node scripts/scan-repos.mjs",
    "signals:classify": "node scripts/classify-signals.mjs",
    "analyze": "node scripts/analyze.mjs",
    "market:sync": "node scripts/market-sync.mjs",
    "test": "node --test \"scripts/test/*.test.mjs\"",
    "verify": "node scripts/build.mjs --verify"
  }
}
